#!/usr/bin/env nu

const unit = "night-light.service"

def is-active [] {
  (^systemctl --user --quiet is-active $unit | complete).exit_code == 0
}

def main [] {
  if (is-active) {
    ^systemctl --user stop $unit
  } else {
    ^systemctl --user start $unit
  }
  ^eww poll sunset_state | complete | ignore
}

def "main status" [] {
  print (if (is-active) { "activated" } else { "deactivated" })
}
