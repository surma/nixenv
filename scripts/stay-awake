#!/usr/bin/env nu

# This script controls the Eww stay-awake button.
# Hypridle respects its transient logind idle inhibitor.
# The systemd unit stores the state across Eww reloads.

const unit = "stay-awake.service"

def is-active [] {
  (^systemctl --user --quiet is-active $unit | complete).exit_code == 0
}

def main [] {
  error make { msg: "usage: stay-awake status|toggle" }
}

def "main status" [] {
  print (if (is-active) { "activated" } else { "deactivated" })
}

def "main toggle" [] {
  if (is-active) {
    ^systemctl --user stop $unit
  } else {
    # --collect unloads the unit even if it fails, so the name stays free.
    (^systemd-run --user --quiet --collect $"--unit=($unit)" "--description=Stay awake"
      systemd-inhibit --what=idle --who=stay-awake "--why=Stay awake button"
      sleep infinity)
  }
  # Refresh the Eww button after the inhibitor changes.
  ^eww poll stay_awake | complete | ignore
}
