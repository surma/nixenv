(deflisten workspaces :initial "[]" "@WORKSPACES@")
(deflisten volume :initial "" "@VOLUME@")
(deflisten volume_state :initial "normal" "@VOLUME_STATE@")
(deflisten battery :initial "" "@BATTERY@")
(deflisten battery_class :initial "" "@BATTERY_CLASS@")
(deflisten power_profile :initial "" "@POWER_PROFILE@")
(deflisten power_profile_tooltip :initial "" "@POWER_PROFILE_TOOLTIP@")
(defvar stay_awake "deactivated")
@SUNSET_DEFINITION@
@SCRIPT_MENU_DEFINITIONS@

(defwidget stay_awake_button []
  (button
    :class {stay_awake == "activated" ? "stay-awake active" : "stay-awake"}
    :tooltip "Stay awake"
    :onclick "@STAY_AWAKE_CLICK@"
    (label :text {stay_awake == "activated" ? "" : ""})))

(defwidget volume_button []
  (button
    :class {volume_state == "muted" ? "volume muted" : "volume"}
    :onclick "@PAVUCONTROL@"
    (label :text volume)))

(defwidget power_profile_button []
  (button
    :class {power_profile == "performance" ? "power-profile performance" : power_profile == "balanced" ? "power-profile balanced" : power_profile == "power-saver" ? "power-profile power-saver" : "power-profile"}
    :visible {power_profile != ""}
    :tooltip {power_profile_tooltip}
    :onclick "@POWER_PROFILE_CYCLE@"
    (label :text {power_profile == "balanced" ? "" : power_profile == "power-saver" ? "" : ""})))

(defwidget workspace_list [screen]
  (box :class "workspaces"
       :orientation "h"
       :space-evenly false
       :spacing 0
    (for workspace in workspaces
      (button
        :class @WORKSPACE_CLASS@
        :visible {workspace.output == screen}
        :onclick "@FOCUS_WORKSPACE@ ${workspace.output} ${workspace.index}"
        (label :text {workspace.label})))))

(defwidget bar_content [screen]
  (centerbox :class "bar" :orientation "h" :hexpand true
    (workspace_list :screen screen)
    (label :class "clock" :text {formattime(EWW_TIME, "%a, %F %H:%M")})
    (box :class "status" :orientation "h" :halign "end" :space-evenly false :spacing 4
      @SCRIPT_MENU_BUTTON@
      (stay_awake_button)
      @SUNSET_WIDGET@
      (volume_button)
      (power_profile_button)
      (label :class {battery_class} :text battery :visible {battery != ""})
      (systray :class "tray" :icon-size 16 :spacing 10))))

(defwindow bar [screen]
  :monitor screen
  :exclusive true
  :geometry (geometry
    :x "0%"
    :y "0px"
    :width "100%"
    :height "30px"
    :anchor "top center")
  (bar_content :screen screen))
